#!/bin/bash

# Collect container status from one or more Docker contexts in parallel and
# print a single JSON array, one entry per context:
#
#   [{ "name": "default", "endpoint": "unix:///var/run/docker.sock",
#      "ok": true, "error": "", "containers": [ {docker ps json}, ... ] }]
#
# Usage: dockarchy-status [--all] [--stats] [--timeout SEC] [--max-bytes N] [--podman HOSTS] [context ...]
#
# --podman takes a comma-separated list of Podman hosts: "local" for this
# machine's podman, or "[user@]host[:port]" for podman over ssh. They appear as
# extra hosts named "podman" / "podman@host" with podman:// endpoints, and
# their JSON is normalised to docker's row shape on the host itself.
#
# With --stats each container also carries a "Stats" object from
# `docker stats --no-stream` (CPUPerc, MemUsage, MemPerc, NetIO, PIDs…), or
# null for containers that are not running. Stats add ~1-2s per poll because
# docker samples twice to compute CPU%.
#
# Without explicit contexts every context known to `docker context ls` is
# queried. Remote hosts are just contexts with an ssh:// endpoint, so the same
# code path covers local and distant daemons. Each context is bounded by
# `timeout` so one unreachable server never blocks the others.

set -uo pipefail

ALL=""
STATS=""
TIMEOUT=10
MAX_BYTES=$((8 * 1024 * 1024))
PODMAN=""
CONTEXTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --all) ALL="-a"; shift ;;
  --stats) STATS="1"; shift ;;
  --timeout) TIMEOUT="${2:-10}"; shift 2 ;;
  --podman) PODMAN="${2:-}"; shift 2 ;;
  --max-bytes) MAX_BYTES="${2:-8388608}"; shift 2 ;;
  --) shift; CONTEXTS+=("$@"); break ;;
  *) CONTEXTS+=("$1"); shift ;;
  esac
done

if ! command -v docker >/dev/null 2>&1 && [[ -z $PODMAN ]]; then
  jq -cn '{installed: false, hosts: []}'
  exit 0
fi

# name<TAB>endpoint for every known context. This is local metadata only and
# never touches a daemon, so it is fast even when remote hosts are down.
declare -A ENDPOINTS=()
KNOWN=()
while IFS=$'\t' read -r name endpoint; do
  [[ -z $name ]] && continue
  ENDPOINTS["$name"]="$endpoint"
  KNOWN+=("$name")
done < <(docker context ls --format '{{.Name}}\t{{.DockerEndpoint}}' 2>/dev/null)

if [[ ${#CONTEXTS[@]} -eq 0 ]]; then
  CONTEXTS=("${KNOWN[@]}")
fi
[[ ${#CONTEXTS[@]} -eq 0 && -z $PODMAN ]] && CONTEXTS=("default")
if ! command -v docker >/dev/null 2>&1; then CONTEXTS=(); fi

# Podman hosts become pseudo-contexts; the endpoint scheme tells query() and
# the widget which engine and transport to use.
IFS=',' read -ra PODMAN_HOSTS <<<"$PODMAN"
for ph in "${PODMAN_HOSTS[@]}"; do
  ph="${ph// /}"
  [[ -z $ph ]] && continue
  ph="${ph#ssh://}"
  if [[ $ph == local || $ph == localhost ]]; then
    ENDPOINTS["podman"]="podman://local"; CONTEXTS+=("podman")
  else
    ENDPOINTS["podman@${ph#*@}"]="podman+ssh://$ph"; CONTEXTS+=("podman@${ph#*@}")
  fi
done

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Run a command with hard ceilings: stdout is cut at MAX_BYTES (+1 so an
# overrun is detectable), stderr at 64 KiB, both while streaming, so a
# misbehaving daemon or a compromised ssh peer cannot fill the disk or,
# via jq --slurpfile, memory. Returns 125 when stdout exceeded the limit,
# otherwise the command's own status (124 from `timeout`).
STDERR_MAX=65536
bounded_run() {
  local out="$1" err="$2" max="$3"
  shift 3
  { "$@" 2>&1 1>&3 3>&- | head -c "$STDERR_MAX" >"$err"; exit "${PIPESTATUS[0]}"; } 3>&1 | head -c "$((max + 1))" >"$out"
  local rc="${PIPESTATUS[0]}"
  if [[ $(stat -c %s "$out" 2>/dev/null || echo 0) -gt $max ]]; then return 125; fi
  return "$rc"
}

# Bound how many hosts are queried at all and at once.
MAX_CONTEXTS=32
MAX_PARALLEL=4

# Remote hosts: run docker *on the server* over exactly one ssh session per
# poll. `docker --context ssh://…` instead opens one ssh session per API call
# — `docker stats` alone means one per container, in parallel — which trips
# sshd MaxSessions/MaxStartups and gets the client banned by fail2ban.
# The local socket is driven directly. Both paths print the same two blocks,
# separated by a marker line: ps JSON lines, then stats JSON lines.
remote_script() {
  local engine="${1:-docker}"
  if [[ $engine == podman ]]; then
    # podman prints JSON arrays with its own field names; reshape them into
    # docker's `ps --format '{{json .}}'` rows so the widget has one model.
    cat <<REMOTE
podman ps $ALL --format json | jq -c '.[] | {
  ID: .Id, Names: (.Names | join(",")), Image: .Image, State: .State, Status: .Status,
  Ports: ((.Ports // []) | map((if .host_ip and .host_ip != "" then .host_ip else "0.0.0.0" end) + ":" + (.host_port|tostring) + "->" + (.container_port|tostring) + "/" + (.protocol // "tcp")) | join(", ")),
  Labels: ((.Labels // {}) | to_entries | map(.key + "=" + (.value|tostring)) | join(",")),
  CreatedAt: (.CreatedAt // "")
}' || exit 9
echo __DOCKARCHY_STATS__
${STATS:+podman stats --no-stream --format json 2>/dev/null | jq -c '.[] | {ID: .id, Name: .name, CPUPerc: .cpu_percent, MemUsage: .mem_usage, MemPerc: .mem_percent, NetIO: .net_io, BlockIO: .block_io, PIDs: (.pids|tostring)}' || true}
REMOTE
  else
    cat <<REMOTE
docker ps $ALL --no-trunc --format '{{json .}}' || exit 9
echo __DOCKARCHY_STATS__
${STATS:+docker stats --no-stream --format '{{json .}}' 2>/dev/null || true}
REMOTE
  fi
}

# ssh://[user@]host[:port] -> ssh argv. Everything else about the connection
# (keys, ControlMaster, ProxyJump…) comes from the user's ~/.ssh/config.
ssh_argv_for() {
  local url="$1" rest user hostport host port
  rest="${url#ssh://}"
  rest="${rest%%/*}"
  if [[ $rest == *@* ]]; then user="${rest%%@*}"; hostport="${rest#*@}"; else user=""; hostport="$rest"; fi
  if [[ $hostport == *:* ]]; then host="${hostport%%:*}"; port="${hostport##*:}"; else host="$hostport"; port=""; fi
  SSH_ARGV=(ssh -o BatchMode=yes -o ConnectTimeout="$TIMEOUT" -T)
  [[ -n $port ]] && SSH_ARGV+=(-p "$port")
  [[ -n $user ]] && SSH_ARGV+=(-l "$user")
  SSH_ARGV+=(-- "$host")
}

query() {
  local idx="$1" ctx="$2" rc
  local endpoint="${ENDPOINTS[$ctx]:-}"
  local raw_out="$TMP/$idx.raw" ps_out="$TMP/$idx.ps" stats_out="$TMP/$idx.stats" err_out="$TMP/$idx.err"

  local engine="docker"
  [[ $endpoint == podman* ]] && engine="podman"
  if [[ $endpoint == ssh://* || $endpoint == podman+ssh://* ]]; then
    local SSH_ARGV
    ssh_argv_for "${endpoint#podman+}"
    bounded_run "$raw_out" "$err_out" "$MAX_BYTES" timeout "$TIMEOUT" "${SSH_ARGV[@]}" "bash -s" <<<"$(remote_script "$engine")"
    rc=$?
  elif [[ $engine == podman ]]; then
    bounded_run "$raw_out" "$err_out" "$MAX_BYTES" timeout "$TIMEOUT" bash -s <<<"$(remote_script podman)"
    rc=$?
  else
    # Non-ssh contexts (unix socket, tcp://) go through the context itself,
    # where the per-call transport cost is negligible.
    bounded_run "$raw_out" "$err_out" "$MAX_BYTES" timeout "$TIMEOUT" env DOCKER_CONTEXT="$ctx" bash -s <<<"$(remote_script)"
    rc=$?
  fi
  if [[ $rc -eq 125 ]]; then
    jq -cn --arg name "$ctx" --arg endpoint "$endpoint" --arg error "Response exceeded $MAX_BYTES bytes; refusing to parse it" \
      '{name: $name, endpoint: $endpoint, ok: false, error: $error, containers: []}' >"$TMP/$idx.json"
    return
  fi

  awk -v ps="$ps_out" -v st="$stats_out" '
    BEGIN { out = ps }
    /^__DOCKARCHY_STATS__$/ { out = st; next }
    /^\{/ { print > out }
  ' "$raw_out"
  : >>"$ps_out"; : >>"$stats_out"

  if [[ $rc -eq 0 ]]; then
    jq -cn --arg name "$ctx" --arg endpoint "$endpoint" \
      --slurpfile ps "$ps_out" --slurpfile st "$stats_out" '
      ($st | map({key: .ID[0:12], value: .}) | from_entries) as $byId
      | {name: $name, endpoint: $endpoint, ok: true, error: "",
         containers: ($ps | map(. + {Stats: ($byId[.ID[0:12]] // null)}))}' \
      >"$TMP/$idx.json" 2>/dev/null \
      || jq -cn --arg name "$ctx" --arg endpoint "$endpoint" --arg error "Unreadable docker ps output" \
        '{name: $name, endpoint: $endpoint, ok: false, error: $error, containers: []}' >"$TMP/$idx.json"
  else
    local msg
    if [[ $rc -eq 124 ]]; then
      msg="Timed out after ${TIMEOUT}s"
    else
      msg="$(head -c 4096 "$err_out" 2>/dev/null | grep -v '^__DOCKARCHY' | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//' | head -c 400)"
      [[ -z $msg ]] && msg="docker exited with status $rc"
    fi
    jq -cn --arg name "$ctx" --arg endpoint "$endpoint" --arg error "$msg" \
      '{name: $name, endpoint: $endpoint, ok: false, error: $error, containers: []}' >"$TMP/$idx.json"
  fi
}

if [[ ${#CONTEXTS[@]} -gt $MAX_CONTEXTS ]]; then
  jq -cn --arg error "$(( ${#CONTEXTS[@]} - MAX_CONTEXTS )) contexts beyond the limit of $MAX_CONTEXTS were skipped" \
    '{name: "…", endpoint: "", ok: false, error: $error, containers: []}' >"$TMP/999.json"
  CONTEXTS=("${CONTEXTS[@]:0:$MAX_CONTEXTS}")
fi

i=0
running=0
for ctx in "${CONTEXTS[@]}"; do
  query "$(printf '%03d' "$i")" "$ctx" &
  i=$((i + 1))
  running=$((running + 1))
  if [[ $running -ge $MAX_PARALLEL ]]; then
    wait -n
    running=$((running - 1))
  fi
done
wait

# Files are zero-padded so the shell glob keeps the caller's context order.
jq -cs '{installed: true, hosts: .}' "$TMP"/*.json
