#!/bin/bash
# Fake ssh: run the remote script locally with DOCKER_CONTEXT set to the host,
# so the stub docker can label its output. Accepts the flags the collector passes.
host=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|-p|-l) shift 2 ;;
    -T|-t) shift ;;
    --) host="$2"; shift 2; break ;;
    *) host="$1"; shift; break ;;
  esac
done
# Real ssh joins the remaining argv into one remote command line; the
# collector passes "bash -s" as a single word, so match the joined form.
[[ "$*" == "bash -s" ]] || { echo "stub ssh: unexpected command: $*" >&2; exit 2; }
DOCKER_CONTEXT="remote" exec bash -s
